table fact_abyss_usage
	lineageTag: 5ca2bdfe-3186-5bbd-9ffd-b856bcb9439b

	measure 'Выбранный период №' =
			VAR s = SELECTEDVALUE('Выбор периода'[№])
			RETURN
			    IF(ISBLANK(s), CALCULATE(MAX(dim_period[period_order]), REMOVEFILTERS(dim_period)), s)
		formatString: 0
		displayFolder: Служебные
		lineageTag: 023c78e5-bd51-590d-98ad-88e6efdc5a1a

	measure 'Подпись периода' =
			VAR p = [Выбранный период №]
			VAR cur = CALCULATE(MAX(dim_period[Период]), REMOVEFILTERS(dim_period), dim_period[period_order] = p)
			VAR prev = CALCULATE(MAX(dim_period[Период]), REMOVEFILTERS(dim_period), dim_period[period_order] = p - 1)
			RETURN
			    "Период: " & cur & IF(ISBLANK(prev), "", "  ·  сравнение с периодом " & prev) & "  ·  целевой коридор usage rate: 5–40 %"
		displayFolder: Служебные
		lineageTag: fe8e9b0a-4970-58e0-9a1d-85100e8124c0

	measure 'Usage rate, %' =
			VAR p = [Выбранный период №]
			RETURN
			    CALCULATE(AVERAGE(fact_abyss_usage[usage_rate_pct]), REMOVEFILTERS(dim_period), dim_period[period_order] = p)
		formatString: 0.0
		displayFolder: Использование
		lineageTag: 8a4096a0-1493-5693-b160-dad60e44438b

	measure 'Usage rate прошлого периода, %' =
			VAR p = [Выбранный период №]
			RETURN
			    CALCULATE(AVERAGE(fact_abyss_usage[usage_rate_pct]), REMOVEFILTERS(dim_period), dim_period[period_order] = p - 1)
		formatString: 0.0
		displayFolder: Использование
		lineageTag: bcce6baa-6a5c-5610-a003-3a473b485db0

	measure 'Δ usage rate (пп)' =
			VAR c = [Usage rate, %]
			VAR pr = [Usage rate прошлого периода, %]
			RETURN
			    IF(NOT ISBLANK(c) && NOT ISBLANK(pr), c - pr)
		formatString: +0.0;-0.0;0.0
		displayFolder: Использование
		lineageTag: 0d13fbaa-019a-5975-8516-93ba801d4017

	measure 'Usage rate (динамика), %' = AVERAGE(fact_abyss_usage[usage_rate_pct])
		formatString: 0.0
		displayFolder: Использование
		lineageTag: 9fac9210-5097-5e1a-8629-f8fc0b719ab7

	measure 'Персонажей в анализе' =
			VAR p = [Выбранный период №]
			RETURN
			    CALCULATE(COUNTROWS(fact_abyss_usage), REMOVEFILTERS(dim_period), dim_period[period_order] = p)
		formatString: 0
		displayFolder: Коридор
		lineageTag: 3735454e-0c97-55a8-8646-7214ce667cee

	measure 'Доминантов (>40%)' =
			VAR p = [Выбранный период №]
			RETURN
			    CALCULATE(COUNTROWS(fact_abyss_usage), fact_abyss_usage[corridor_status] = "Доминант (>40%)", REMOVEFILTERS(dim_period), dim_period[period_order] = p) + 0
		formatString: 0
		displayFolder: Коридор
		lineageTag: 53940f35-5a6a-551b-bdec-2db43fc96b94

	measure 'Доминантов прошлого периода' =
			VAR p = [Выбранный период №]
			RETURN
			    CALCULATE(COUNTROWS(fact_abyss_usage), fact_abyss_usage[corridor_status] = "Доминант (>40%)", REMOVEFILTERS(dim_period), dim_period[period_order] = p - 1) + 0
		formatString: 0
		displayFolder: Коридор
		lineageTag: 6330fdb0-bd9f-5793-9afe-c1e4bcc06e7a

	measure 'Невостребованных (<5%)' =
			VAR p = [Выбранный период №]
			RETURN
			    CALCULATE(COUNTROWS(fact_abyss_usage), fact_abyss_usage[corridor_status] = "Невостребован (<5%)", REMOVEFILTERS(dim_period), dim_period[period_order] = p) + 0
		formatString: 0
		displayFolder: Коридор
		lineageTag: 07134dfe-487f-5aa1-9054-32019761dbe7

	measure 'Невостребованных прошлого периода' =
			VAR p = [Выбранный период №]
			RETURN
			    CALCULATE(COUNTROWS(fact_abyss_usage), fact_abyss_usage[corridor_status] = "Невостребован (<5%)", REMOVEFILTERS(dim_period), dim_period[period_order] = p - 1) + 0
		formatString: 0
		displayFolder: Коридор
		lineageTag: dbb0c2e0-33b8-5898-b466-b024218d97ec

	measure 'В коридоре, %' =
			VAR p = [Выбранный период №]
			RETURN
			    DIVIDE(
			        CALCULATE(COUNTROWS(fact_abyss_usage), REMOVEFILTERS(dim_period), dim_period[period_order] = p, fact_abyss_usage[corridor_status] = "В коридоре"),
			        CALCULATE(COUNTROWS(fact_abyss_usage), REMOVEFILTERS(dim_period), dim_period[period_order] = p)
			    ) * 100
		formatString: 0.0
		displayFolder: Коридор
		lineageTag: 6cb35ea7-5051-5b4b-a82e-ae2872645770

	measure 'В коридоре прошлого периода, %' =
			VAR p = [Выбранный период №]
			RETURN
			    DIVIDE(
			        CALCULATE(COUNTROWS(fact_abyss_usage), REMOVEFILTERS(dim_period), dim_period[period_order] = p - 1, fact_abyss_usage[corridor_status] = "В коридоре"),
			        CALCULATE(COUNTROWS(fact_abyss_usage), REMOVEFILTERS(dim_period), dim_period[period_order] = p - 1)
			    ) * 100
		formatString: 0.0
		displayFolder: Коридор
		lineageTag: 8e82a9f9-deff-55e6-89a3-688cb3367909

	measure 'Доля топ-10 в использованиях, %' =
			VAR p = [Выбранный период №]
			VAR t =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES(dim_character[character_id]), "@u", CALCULATE(SUM(fact_abyss_usage[users]))),
			        REMOVEFILTERS(dim_period),
			        dim_period[period_order] = p
			    )
			VAR topT = TOPN(10, t, [@u], DESC)
			RETURN
			    DIVIDE(SUMX(topT, [@u]), SUMX(t, [@u])) * 100
		formatString: 0.0
		displayFolder: Концентрация
		lineageTag: c28c0754-5cf9-5dc3-a7a0-e694ce8aefba

	measure 'Доля топ-10 прошлого периода, %' =
			VAR p = [Выбранный период №] - 1
			VAR t =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES(dim_character[character_id]), "@u", CALCULATE(SUM(fact_abyss_usage[users]))),
			        REMOVEFILTERS(dim_period),
			        dim_period[period_order] = p
			    )
			VAR topT = TOPN(10, t, [@u], DESC)
			RETURN
			    DIVIDE(SUMX(topT, [@u]), SUMX(t, [@u])) * 100
		formatString: 0.0
		displayFolder: Концентрация
		lineageTag: 7731c585-5fe2-51bd-a3c3-1a33c6011aaa

	measure 'Δ текст: usage rate' =
			VAR c = [Usage rate, %]
			VAR pr = [Usage rate прошлого периода, %]
			RETURN
			    IF(
			        ISBLANK(pr),
			        "нет данных за прошлый период",
			        "Δ " & FORMAT(c - pr, "+0.0;-0.0;0.0") & " п.п. к прошлому периоду"
			    )
		displayFolder: Сравнение
		lineageTag: d2500bc7-6677-5916-a853-2180d51278ab

	measure 'Δ текст: в коридоре' =
			VAR c = [В коридоре, %]
			VAR pr = [В коридоре прошлого периода, %]
			RETURN
			    IF(
			        ISBLANK(pr),
			        "нет данных за прошлый период",
			        "Δ " & FORMAT(c - pr, "+0.0;-0.0;0.0") & " п.п. к прошлому периоду"
			    )
		displayFolder: Сравнение
		lineageTag: 06aefa95-7c62-57ec-9870-78a570674400

	measure 'Δ текст: доминанты' =
			VAR c = [Доминантов (>40%)]
			VAR pr = [Доминантов прошлого периода]
			RETURN
			    IF(
			        ISBLANK(pr),
			        "нет данных за прошлый период",
			        "Δ " & FORMAT(c - pr, "+0;-0;0") & " шт. к прошлому периоду"
			    )
		displayFolder: Сравнение
		lineageTag: d79a805a-3ea9-5935-8c71-354d01292502

	measure 'Δ текст: невостребованные' =
			VAR c = [Невостребованных (<5%)]
			VAR pr = [Невостребованных прошлого периода]
			RETURN
			    IF(
			        ISBLANK(pr),
			        "нет данных за прошлый период",
			        "Δ " & FORMAT(c - pr, "+0;-0;0") & " шт. к прошлому периоду"
			    )
		displayFolder: Сравнение
		lineageTag: 63c3c239-85a2-5d94-9f1b-93b11425080a

	measure 'Δ текст: топ-10' =
			VAR c = [Доля топ-10 в использованиях, %]
			VAR pr = [Доля топ-10 прошлого периода, %]
			RETURN
			    IF(
			        ISBLANK(pr),
			        "нет данных за прошлый период",
			        "Δ " & FORMAT(c - pr, "+0.0;-0.0;0.0") & " п.п. к прошлому периоду"
			    )
		displayFolder: Сравнение
		lineageTag: 4ca19a85-4427-55a3-946a-30bd9c675d31

	measure 'План: нижняя граница, %' = IF(NOT ISBLANK([Usage rate, %]), 5)
		formatString: 0
		displayFolder: План
		lineageTag: 5e12cc73-f348-53e0-a4c0-21ba874dc817

	measure 'План: верхняя граница, %' = IF(NOT ISBLANK([Usage rate, %]), 40)
		formatString: 0
		displayFolder: План
		lineageTag: ff4f4487-73bc-58d0-90fb-3fb2b49a6be5

	measure 'Требует внимания' =
			VAR u = [Usage rate, %]
			VAR d = [Δ usage rate (пп)]
			RETURN
			    IF(NOT ISBLANK(u) && (u > 40 || u < 5 || ABS(d) >= 10), 1)
		formatString: 0
		displayFolder: Внимание
		lineageTag: 608eb40a-e7a2-590f-9508-efc0c95f6ee4

	measure 'Внимание: usage rate, %' = IF([Требует внимания] = 1, [Usage rate, %])
		formatString: 0.0
		displayFolder: Внимание
		lineageTag: 313734c5-6f21-5f21-8ed8-3af60045dc16

	measure 'Внимание: Δ к прошлому периоду (пп)' = IF([Требует внимания] = 1, [Δ usage rate (пп)])
		formatString: +0.0;-0.0;0.0
		displayFolder: Внимание
		lineageTag: b6449684-6c56-550c-8734-81a1bf745176

	measure 'Внимание: отклонение от коридора (пп)' =
			VAR u = [Usage rate, %]
			RETURN
			    IF([Требует внимания] = 1, SWITCH(TRUE(), u > 40, u - 40, u < 5, u - 5, 0))
		formatString: +0.0;-0.0;0.0
		displayFolder: Внимание
		lineageTag: f6157bae-a1cc-5019-a898-91df4a711b63

	measure 'Внимание: причина' =
			VAR u = [Usage rate, %]
			VAR d = [Δ usage rate (пп)]
			RETURN
			    IF(
			        [Требует внимания] = 1,
			        SWITCH(
			            TRUE(),
			            u > 40, "Выше коридора",
			            u < 5, "Ниже коридора",
			            d > 0, "Резкий рост",
			            "Резкое падение"
			        )
			    )
		displayFolder: Внимание
		lineageTag: 1d443366-3488-56e8-9e4b-d2b5b0bc369b

